# Server
# Unset: every interface, IPv6 and IPv4. Set to bind one address only.
# HOST=0.0.0.0
PORT=4000
RUST_LOG=info

# Database. A plain `cargo run` builds with SQLite; unset, it is
# sqlite:///data/llmtrack.db (the Docker volume). Locally keep it next to you.
DATABASE_URL=sqlite://./llmtrack.db
# PostgreSQL: docker compose up -d postgres, then
#   cargo run --no-default-features --features postgres
# DATABASE_URL=postgres://llmtrack:llmtrack@localhost:5432/llmtrack
# DATABASE_MAX_CONNECTIONS=10

# Required, at least 64 characters: signs the session cookie and encrypts the
# provider API keys stored in the database. Changing it makes every stored
# provider key unreadable. Generate with: openssl rand -hex 32
SECRET_KEY=

# Set to true behind a TLS-terminating proxy: secure cookies.
# SSL_PROXY=true

# First admin, created only into an empty database. Format: email:password
# CREATE_SUPERUSER=admin@example.com:changeme123

# Master key: `Authorization: Bearer <key>` on the management API
# (/api) acts as the first admin, for scripts and CI. Starts with sk-,
# at least 20 characters. LITELLM_MASTER_KEY is read too, for compatibility. A personal virtual
# key also works there, acting as its owner.
# MASTER_KEY=sk-...

# How long the gateway waits on a silent provider (seconds, per read).
# UPSTREAM_TIMEOUT_SECS=600

# Where the compiled dashboard is; `off` serves the API only.
# LLMTRACK_DASHBOARD_DIR=./static
# LLMTRACK_DASHBOARD=off
